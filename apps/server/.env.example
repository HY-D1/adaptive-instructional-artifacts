QUALTRICS_PRE_SURVEY_URL=
QUALTRICS_POST_SURVEY_URL=
QUALTRICS_COMPLETION_SIGNING_SECRET=
# Optional live ResponseID check (see QUALTRICS_SETUP.md).
QUALTRICS_API_TOKEN=
QUALTRICS_DATACENTER=
# Isolated test deployments only: accept non-Qualtrics ResponseIDs.
SURVEY_ALLOW_SYNTHETIC_RESPONSE_IDS=false
# Comma-separated learner IDs allowed to switch the active corpus run.
CORPUS_ADMIN_LEARNER_IDS=
WEB_APP_BASE_URL=
STUDENT_DATA_RATE_LIMIT=600
SIGNUP_RATE_LIMIT=100
LLM_RATE_LIMIT=60
BANDIT_READ_RATE_LIMIT=300
BANDIT_REWARD_RATE_LIMIT=60
SURVEY_RATE_LIMIT=100
# Set to true on Vercel (and any reverse proxy) so req.ip is the client IP;
# otherwise IP-keyed limits (login, signup) share one bucket. A one-time
# [startup/client-ip-check] log line shows what the server sees.
TRUST_PROXY=false
# Keys the email hashes in research exports (HMAC); hashes are omitted if unset.
RESEARCH_EXPORT_HASH_SECRET=
# Default off. Set a private, nonempty operator key before enabling maintenance.
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_KEY=
VERCEL_ENV=
# Cookie SameSite policy for cross-origin deployments.
AUTH_COOKIE_SAMESITE=
# Cookie Secure override; production defaults to secure cookies.
AUTH_COOKIE_SECURE=
# Skip cold-start schema initialization only after provisioning the schema.
AUTO_SCHEMA_INIT=
# Additional allowed frontend origins, comma-separated.
CORS_ORIGINS=
# Additional allowed frontend origin patterns, comma-separated.
CORS_ORIGIN_PATTERNS=
# Legacy SQLite database file path; not used by Neon production mode.
DATABASE_PATH=
# Test-only seed secret; do not set for normal production. The test-seed route
# also requires VERCEL_ENV=preview or NODE_ENV=development|test, and refuses the
# Vercel production Neon integration variables.
E2E_TEST_SEED_SECRET=
# JWT signing secret; required in production.
JWT_SECRET=
# Ollama default model override.
OLLAMA_DEFAULT_MODEL=
# Ollama fallback model override.
OLLAMA_FALLBACK_MODEL=
# Probability of assigning the adaptive condition.
STUDENT_CONDITION_ADAPTIVE_PROBABILITY=
# SQL-Adapt Backend Server Environment Variables

# =============================================================================
# Server Configuration
# =============================================================================

# Server port (default: 3001)
PORT=3001

# CORS origin for frontend requests
# In development: http://localhost:5173
# In production: your frontend URL (e.g., https://sql-adapt.com)
CORS_ORIGIN=http://localhost:5173
# Optional explicit allowlist (comma-separated) for multiple frontend origins
# CORS_ORIGINS=https://app.example.com,https://www.example.com
# Optional wildcard allowlist for trusted preview domains. There is NO default.
# `*` matches one hostname fragment ([a-z0-9-]+), never dots. Pin your Vercel
# team slug so same-named projects in other scopes cannot match:
# CORS_ORIGIN_PATTERNS=https://your-project-*-your-team-slug.vercel.app

# Node environment
NODE_ENV=development

# =============================================================================
# Database Configuration (Neon PostgreSQL)
# =============================================================================

# Neon PostgreSQL connection string (REQUIRED for production)
# Get your connection string from: https://neon.tech
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL=

# Alternative: Neon-specific environment variable
NEON_DATABASE_URL=

# Automatic schema initialization.
# initializeSchema() runs ~40 sequential CREATE TABLE/INDEX round-trips to Neon
# on every serverless cold start. Once the schema is provisioned out-of-band
# (run `npm run db:init:neon` once), set this to false to skip the per-cold-start
# init and reduce latency. Unset/any-other-value preserves auto-init (default).
# AUTO_SCHEMA_INIT=false

# =============================================================================
# Authentication Access Codes
# =============================================================================

# Required for production account signup flows
# Student accounts must provide this class code at signup.
STUDENT_SIGNUP_CODE=ClassSQL2026

# Instructor accounts must provide this code at signup.
INSTRUCTOR_SIGNUP_CODE=TeachSQL2026

# Auth/CSRF cookie SameSite + Secure attributes (sql_adapt_auth, sql_adapt_csrf).
# Defaults preserve prior behavior: production => SameSite=None; Secure (works
# cross-site), non-prod => SameSite=Lax; not Secure.
# Set SameSite=lax ONLY when the frontend calls the API on its own origin
# (Vercel rewrite + VITE_API_BASE_URL=same-origin). Flipping to lax while the
# frontend still calls a different backend host breaks auth for everyone.
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true

# =============================================================================
# Feature Flags
# =============================================================================

# Enable PDF index feature
# When enabled, allows PDF upload and indexing
# Requires pdftotext (Poppler) to be installed
ENABLE_PDF_INDEX=false

# Enable LLM proxy feature
# When enabled, proxies LLM requests to Ollama
ENABLE_LLM=false

# =============================================================================
# PDF Index Configuration
# =============================================================================

# Directory for PDF index storage
# Default: ./data/pdf-index
PDF_INDEX_DIR=./data/pdf-index

# Directory for source PDF files
# Default: ./data/pdfs
PDF_SOURCE_DIR=./data/pdfs

# =============================================================================
# LLM Configuration
# =============================================================================

# Ollama base URL
# Default: http://127.0.0.1:11434 (local Ollama)
# Can be set to a remote Ollama instance for production
OLLAMA_BASE_URL=http://127.0.0.1:11434

# LLM Provider Configuration
# Set to 'groq' for hosted LLM or 'ollama' for local LLM
LLM_PROVIDER=ollama

# Groq API Configuration (required when LLM_PROVIDER=groq)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Extra models clients may request (comma-separated). Requests for any other
# model fall back to the provider default. /api/llm/* requires a logged-in user.
# LLM_ALLOWED_MODELS=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# =============================================================================
# Quick Start Examples
# =============================================================================

# --- Local Development (Full Features) ---
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# ENABLE_PDF_INDEX=true
# ENABLE_LLM=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Production with Groq + Neon ---
# PORT=3001
# CORS_ORIGIN=https://sql-adapt.com
# DATABASE_URL=postgresql://...
# ENABLE_PDF_INDEX=false
# ENABLE_LLM=true
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b

# --- Production with Remote Ollama ---
# PORT=3001
# CORS_ORIGIN=https://sql-adapt.com
# ENABLE_PDF_INDEX=true
# ENABLE_LLM=true
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://your-ollama-server:11434

# --- Minimal Mode (No AI Features) ---
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# ENABLE_PDF_INDEX=false
# ENABLE_LLM=false
