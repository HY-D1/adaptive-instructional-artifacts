# Deployment upload hygiene for the backend project (rooted at apps/server).
# The serverless build needs api/**, src/**, package manifests, tsconfig.json,
# and vercel.json.

# Environment and local auth state
.env
.env.*
!.env.example

# Local SQLite data
data/
*.db
*.sqlite
*.sqlite3

# Build output (Vercel builds api/index.ts from source)
dist/

# OS metadata and local Vercel state
.DS_Store
.vercel/
